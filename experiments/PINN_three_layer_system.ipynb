    "# --------------------------------------------------\n",
    "# Print final losses\n",
    "# --------------------------------------------------\n",
    "print(\"\\nFinal Best Losses\")\n",
    "print(\"-\"*40)\n",
    "print(f\"{'k':<12} {'Best Loss':<15}\")\n",
    "\n",
    "for k, L in zip(k_list, final_losses):\n",
