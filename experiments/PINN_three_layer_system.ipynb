   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.interpolate import make_interp_spline\n",
    "from scipy.optimize import brentq\n",
    "from numpy.lib.scimath import sqrt\n",
    "\n",
    "# ==============================\n",
    "# Load PINN data (SAVED FILE)\n",
    "# ==============================\n",
    "pinn = np.loadtxt(\"PINN_dispersion.csv\", delimiter=\",\", skiprows=1)\n",
    "\n",
    "kH = pinn[:, 0]\n",
    "c_pinn = pinn[:, 1]   # c / c_ref\n",
    "\n",
    "\n",
    "# ==============================\n",
    "# Material & physical parameters\n",
    "# ==============================\n",
    "rho1 = 9890.0\n",
    "rho2 = 3400.0\n",
    "\n",
    "mu44l = 4.35e9\n",
    "mu66l = 5.0e9\n",
    "mu44h = 5.3e9\n",
    "mu66h = 6.47e9\n",
    "\n",
    "\n",
    "phi = np.pi /6\n",
    "H = 6.0\n",
    "mueH02 = 0.3 * mu44l\n",
    "P1 = 1e9\n",
    "P2 = 1e8\n",
    "g = 9.81\n",
    "beta1 = 5.0\n",
    "beta2 = 10.0\n",
    "G = 1.0\n",
    "\n",
    "c_ref = np.sqrt(mu44l / rho1)\n",
    "\n",
    "\n",
    "# ==============================\n",
    "# Analytical dispersion equation\n",
    "# ==============================\n",
    "def dispersion_meq(kH, c_norm):\n",
    "    k = kH / H\n",
    "    c = c_norm * c_ref\n",
    "\n",
    "    term1 = mu44l * beta1 - 1j * mueH02 * k * np.sin(2 * phi)\n",
    "    term2 = mu44l + mueH02 * np.sin(phi)**2\n",
    "    term3 = k**2 * (-mu66l + P1/2 - mueH02 * np.cos(phi)**2 + rho1*c**2)\n",
    "\n",
    "    alpha = sqrt(1 + (4*k**2)/beta2**2)\n",
    "\n",
    "    term01 = k**2 * (-mu66h + mu44h + P2/2 + rho2*c**2)\n",
    "    term02 = (beta2*rho2*g)/4\n",
    "    term03 = 2/(rho2*g*beta2*alpha)\n",
    "\n",
    "    s = term03*(term01 + term02)\n",
    "\n",
    "    c1 = term1/term2\n",
    "    c2 = term3/term2\n",
    "    gamma = sqrt(c2 - c1**2/4)\n",
    "\n",
    "    betak = sqrt(1 + beta2**2/(4*k**2))\n",
    "\n",
    "    term8 = ((c1/2) + gamma*np.tan(gamma*H)) / \\\n",
    "            (gamma - (c1/2)*np.tan(gamma*H))\n",
    "\n",
    "    term11 = rho2*g/4 - mu44h*beta2/2\n",
    "    term6 = (s + 0.5)**2\n",
    "    term10 = (term6*G)/(2*((betak*4/G) - term6))\n",
    "\n",
    "    FW = -k*(betak - 2*s + term10)\n",
    "\n",
    "    meq = (term11 + mu44h*FW) - (mu44l*c1)/2 - mu44l*gamma*term8\n",
    "\n",
    "    return np.real(meq)\n",
    "\n",
    "\n",
    "# ==============================\n",
    "# Compute analytical solution\n",
    "# ==============================\n",
    "def analytical_c_norm(kH_val):\n",
    "    return brentq(lambda c: dispersion_meq(kH_val, c), 0, 9.0)\n",
    "\n",
    "c_ana = np.array([analytical_c_norm(k) for k in kH])\n",
    "\n",
    "\n",
    "# ==============================\n",
    "# Smooth PINN curve (visual only)\n",
    "# ==============================\n",
    "idx = np.argsort(kH)\n",
    "kH_sorted = kH[idx]\n",
    "c_pinn_sorted = c_pinn[idx]\n",
    "\n",
    "kH_smooth = np.linspace(kH_sorted.min(), kH_sorted.max(), 300)\n",
    "spline = make_interp_spline(kH_sorted, c_pinn_sorted, k=2)\n",
    "c_pinn_smooth = spline(kH_smooth)\n",
    "\n",
    "\n",
    "# ==============================\n",
    "# Plot (EXACTLY like FEM style)\n",
    "# ==============================\n",
    "plt.figure(figsize=(7, 5))\n",
    "\n",
    "# PINN\n",
    "plt.plot(kH_smooth, c_pinn_smooth, '--',\n",
    "         color='tab:blue', linewidth=3, label='Present PINNs')\n",
    "plt.plot(kH, c_pinn, 's', color='tab:blue', markersize=5)\n",
    "\n",
    "# Analytical\n",
    "plt.plot(kH, c_ana, 'o',\n",
    "         color='black', markerfacecolor='none',\n",
    "         markersize=6, label='Analytical')\n",
    "\n",
    "plt.xlabel(r'Dimensionless wavenumber $kH$', fontsize=12)\n",
    "plt.ylabel(r'Dimensionless phase velocity $c/c_s$', fontsize=12)\n",
    "plt.grid(True, linestyle=':', alpha=0.6)\n",
    "plt.legend(fontsize=11, frameon=False)\n",
    "\n",
    "plt.xlim([0.37, 0.7])\n",
    "plt.ylim([1.0, 1.8])\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
