    "import numpy as np\n",
    "\n",
    "# Convert safely to numpy arrays\n",
    "c_pinn = np.asarray(c_pinn).flatten()\n",
    "c_ana  = np.asarray(c_ana).flatten()\n",
    "\n",
    "# -----------------------\n",
    "# Absolute error\n",
    "# -----------------------\n",
    "abs_error = np.abs(c_pinn - c_ana)\n",
    "\n",
    "# -----------------------\n",
    "# Error norms\n",
    "# -----------------------\n",
    "L1_error   = np.mean(abs_error)                       # Mean absolute error\n",
    "L2_error   = np.sqrt(np.mean((c_pinn - c_ana)**2))    # RMSE\n",
    "Linf_error = np.max(abs_error)                        # Max absolute error\n",
    "\n",
    "# -----------------------\n",
    "# Relative errors (important for papers)\n",
    "# -----------------------\n",
    "rel_L1   = np.sum(abs_error) / np.sum(np.abs(c_ana))\n",
    "rel_L2   = np.sqrt(np.sum((c_pinn - c_ana)**2) / np.sum(c_ana**2))\n",
    "rel_Linf = Linf_error / np.max(np.abs(c_ana))\n",
    "\n",
    "# -----------------------\n",
    "# Print nicely\n",
    "# -----------------------\n",
    "print(\"\\nPINN ERROR METRICS\")\n",
    "print(\"----------------------------\")\n",
    "print(f\"L1 Error (MAE):        {L1_error:.3e}\")\n",
    "print(f\"L2 Error (RMSE):       {L2_error:.3e}\")\n",
    "print(f\"L∞ Error (Max):        {Linf_error:.3e}\")\n",
    "print()\n",
    "print(\"RELATIVE ERRORS\")\n",
    "print(\"----------------------------\")\n",
    "print(f\"Relative L1:           {rel_L1:.3e}\")\n",
    "print(f\"Relative L2:           {rel_L2:.3e}\")\n",
    "print(f\"Relative L∞:           {rel_Linf:.3e}\")\n"
   ]
