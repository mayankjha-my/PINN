    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.interpolate import interp1d\n",
    "from matplotlib.ticker import FormatStrFormatter\n",
    "\n",
    "# ==============================\n",
    "# L2 Error Analysis\n",
    "# ==============================\n",
    "\n",
    "# Calculate errors\n",
    "absolute_error = np.abs(c_ana - c_pinn)\n",
    "relative_error = absolute_error / c_ana * 100\n",
    "\n",
    "# Calculate L2 error over the domain\n",
    "l2_error = np.sqrt(np.mean((c_ana - c_pinn)**2))\n",
    "l2_relative_error = l2_error / np.sqrt(np.mean(c_ana**2)) * 100\n",
    "\n",
    "# Create a comprehensive error plot\n",
    "fig, axes = plt.subplots(2, 2, figsize=(12, 10))\n",
    "fig.suptitle('PINN Error Analysis', fontsize=16, fontweight='bold', y=1.02)\n",
    "\n",
    "# Plot 1: Relative error vs kH\n",
    "ax1 = axes[0, 0]\n",
    "ax1.plot(kH, relative_error, 'o-', color='tab:red', markersize=8, \n",
    "         linewidth=2, markerfacecolor='white', markeredgewidth=2)\n",
    "ax1.set_xlabel(r'$kH$', fontsize=12)\n",
    "ax1.set_ylabel('Relative Error (%)', fontsize=12)\n",
    "ax1.grid(True, linestyle=':', alpha=0.7)\n",
    "ax1.set_xlim([0.37, 0.7])\n",
    "ax1.axhline(y=np.mean(relative_error), color='black', linestyle='--', \n",
    "            linewidth=1.5, label=f'Mean: {np.mean(relative_error):.2f}%')\n",
    "ax1.axhline(y=np.median(relative_error), color='blue', linestyle='--', \n",
    "            linewidth=1.5, label=f'Median: {np.median(relative_error):.2f}%')\n",
    "ax1.legend(loc='upper right', frameon=True, fancybox=True)\n",
    "ax1.set_title('Relative Error Distribution', fontsize=13, fontweight='bold')\n",
    "\n",
    "# Plot 2: Absolute error with error bands\n",
    "ax2 = axes[0, 1]\n",
    "ax2.fill_between(kH, 0, absolute_error, alpha=0.3, color='tab:red', \n",
    "                 label='Error area')\n",
    "ax2.plot(kH, absolute_error, 'o-', color='darkred', markersize=6, \n",
    "         linewidth=2, label='Absolute error')\n",
    "ax2.set_xlabel(r'$kH$', fontsize=12)\n",
    "ax2.set_ylabel('Absolute Error |c_ana - c_pinn|', fontsize=12)\n",
    "ax2.grid(True, linestyle=':', alpha=0.7)\n",
    "ax2.set_xlim([0.37, 0.7])\n",
    "ax2.legend(loc='upper left', frameon=True, fancybox=True)\n",
    "ax2.set_title('Absolute Error Distribution', fontsize=13, fontweight='bold')\n",
    "\n",
    "# Plot 3: Comparison with error bars\n",
    "ax3 = axes[1, 0]\n",
    "ax3.errorbar(kH, c_pinn, yerr=absolute_error, fmt='s', color='tab:blue',\n",
    "             ecolor='tab:red', elinewidth=2, capsize=4, capthick=2,\n",
    "             markersize=8, label='PINN ± Error', alpha=0.8)\n",
    "ax3.plot(kH, c_ana, 'o', color='black', markerfacecolor='none',\n",
    "         markersize=10, markeredgewidth=2, label='Analytical')\n",
    "ax3.set_xlabel(r'$kH$', fontsize=12)\n",
    "ax3.set_ylabel(r'$c/c_s$', fontsize=12)\n",
    "ax3.grid(True, linestyle=':', alpha=0.7)\n",
    "ax3.set_xlim([0.37, 0.7])\n",
    "ax3.set_ylim([1.0, 1.8])\n",
    "ax3.legend(loc='upper right', frameon=True, fancybox=True)\n",
    "ax3.set_title('PINN with Error Bars vs Analytical', fontsize=13, fontweight='bold')\n",
    "\n",
    "# Plot 4: Cumulative error and statistics\n",
