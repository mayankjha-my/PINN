    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# Load histories\n",
    "histories = torch.load(\"all_histories.pt\")\n",
    "\n",
    "# Select representative k values\n",
    "k_list = sorted(histories.keys())\n",
    "selected_k = [\n",
    "    k_list[0],                  # smallest k\n",
    "    k_list[len(k_list)//2],     # middle k\n",
    "    k_list[-1]                  # largest k\n",
    "]\n",
    "\n",
    "plt.figure(figsize=(8,5))\n",
    "\n",
    "markers = ['o', 's', '^']\n",
    "\n",
    "for i, k in enumerate(selected_k):\n",
    "\n",
    "    loss = np.array(histories[k][\"total\"])\n",
    "\n",
    "    # Running minimum loss\n",
    "    running_best = np.minimum.accumulate(loss)\n",
    "\n",
    "    plt.semilogy(\n",
    "        running_best,\n",
    "        linewidth=2.5,\n",
    "        marker=markers[i],\n",
    "        markevery=1000,\n",
    "        markersize=5,\n",
    "        label=fr\"$k={k:.2f}$\"\n",
    "    )\n",
    "\n",
    "plt.xlabel(\"Epoch\", fontsize=12)\n",
    "plt.ylabel(\"Running minimum loss\", fontsize=12)\n",
    "\n",
    "plt.grid(True, which='major', linestyle='--', alpha=0.5)\n",
    "plt.grid(True, which='minor', linestyle=':', alpha=0.3)\n",
    "\n",
    "plt.legend(\n",
    "    fontsize=11,\n",
    "    frameon=True,\n",
    "    fancybox=True,\n",
    "    loc='upper right'\n",
