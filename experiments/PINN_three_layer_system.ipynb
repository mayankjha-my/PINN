   "source": [
    "# --------------------------------------------------\n",
    "# Build models ONCE (outside k-loop)\n",
    "# --------------------------------------------------\n",
    "model_layer, model_half = get_all_networks()\n",
    "model_layer.to(DEVICE)\n",
    "model_half.to(DEVICE)\n",
    "\n",
    "dispersion = []\n",
    "all_histories = {}\n",
    "\n",
    "# --------------------------------------------------\n",
    "# Compute shear wave velocities (Love-wave physics)\n",
    "# --------------------------------------------------\n",
    "mu44_layer = torch.tensor(params_layer[\"mu44_0\"], device=DEVICE)\n",
    "rho_layer  = torch.tensor(params_layer[\"rho_0\"], device=DEVICE)\n",
    "mu44_half  = torch.tensor(params_half[\"mu44_0\"], device=DEVICE)\n",
    "rho_half   = torch.tensor(params_half[\"rho_0\"], device=DEVICE)\n",
    "\n",
    "c_shear_layer = torch.sqrt(mu44_layer / rho_layer)\n",
    "c_shear_half  = torch.sqrt(mu44_half  / rho_half)\n",
    "\n",
    "print(\"\\n=== LOVE-WAVE PHYSICS CHECK ===\")\n",
    "print(f\"c_shear_layer = {c_shear_layer.item():.3f}\")\n",
    "print(f\"c_shear_half  = {c_shear_half.item():.3f}\")\n",
    "print(\"Love-wave condition: c_layer < c < c_half\")\n",
    "print(\"================================\\n\")\n",
    "\n",
    "c_min_physical = c_shear_layer\n",
    "c_max_physical = c_shear_half\n",
    "\n",
    "# --------------------------------------------------\n",
    "# Loop over wavenumber k\n",
    "# --------------------------------------------------\n",
    "for idx, k in enumerate(k_values):\n",
    "\n",
    "    k = k.to(DEVICE)\n",
    "\n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"Training for k = {k.item():.3f}\")\n",
    "    print(f\"{'='*60}\")\n",
    "\n",
    "    # ---- initialize c ----\n",
    "    if idx == 0:\n",
    "        c_init = c_shear_layer + 0.83*(c_shear_half - c_shear_layer)\n",
    "    else:\n",
    "        previous_c = torch.tensor(dispersion[-1][1], device=DEVICE)\n",
    "        c_init = 0.95 * previous_c\n",
    "\n",
    "    c = torch.nn.Parameter(c_init.to(DEVICE))\n",
    "\n",
    "    # ---- optimizers ----\n",
    "    optimizer_nets = optim.Adam(\n",
    "        list(model_layer.parameters()) + list(model_half.parameters()),\n",
    "        lr=1e-3\n",
    "    )\n",
    "    optimizer_c = optim.Adam([c], lr=1e-4)\n",
    "\n",
    "    best_loss = float(\"inf\")\n",
    "    best_c = c.item()\n",
    "    prev_c = c.item()\n",
    "\n",
    "    # ---- optional histories ----\n",
    "    c_history = []\n",
    "    loss_total_history = []\n",
    "    loss_pde_history   = []\n",
    "    loss_bc_history    = []\n",
    "    loss_int_history   = []\n",
    "\n",
    "    # ==================================================\n",
    "    # TRAINING LOOP\n",
    "    # ==================================================\n",
    "    for epoch in range(1, 10000):\n",
    "\n",
    "        z_layer, z_half = sample_domain_points(2000, geom)\n",
    "        z_top = sample_top_surface(500, geom)\n",
    "        z_int = sample_interface(500)\n",
    "        z_far = sample_far_field(500, geom)\n",
    "\n",
    "        optimizer_nets.zero_grad()\n",
    "        optimizer_c.zero_grad()\n",
    "\n",
    "        # ---- compute loss ----\n",
    "        loss, logs = total_loss(\n",
    "            model_layer, model_half,\n",
    "            z_layer, z_half,\n",
    "            z_top, z_int, z_far,\n",
    "            params_layer, params_half,\n",
    "            k, c,\n",
    "            w_pde=1.0,\n",
    "            w_bc=5.0,\n",
    "            w_int=10.0,\n",
    "            w_far=5.0,\n",
    "            w_amp=0.5\n",
    "        )\n",
    "\n",
    "        # ---- store histories ----\n",
    "        loss_total_history.append(loss.item())\n",
    "        loss_pde_history.append(logs['pde'])\n",
    "        loss_bc_history.append(logs['bc_top'])\n",
    "        loss_int_history.append(logs['interface'])\n",
    "\n",
    "        # ---- physics penalty ----\n",
    "        physics_penalty = (\n",
    "            1000.0 * torch.relu(c_min_physical - c)**2 +\n",
    "            1000.0 * torch.relu(c - c_max_physical)**2\n",
    "        )\n",
    "\n",
    "        if idx > 0:\n",
    "            previous_c = torch.tensor(dispersion[-1][1], device=DEVICE)\n",
    "            physics_penalty += 5000.0 * torch.relu(c - previous_c)**2\n",
    "\n",
    "        total_loss_with_physics = loss + physics_penalty\n",
    "        total_loss_with_physics.backward()\n",
    "\n",
    "        # ---- gradient clipping ----\n",
    "        torch.nn.utils.clip_grad_norm_(\n",
    "            list(model_layer.parameters()) +\n",
    "            list(model_half.parameters()) + [c], 1.0\n",
    "        )\n",
    "\n",
    "        optimizer_nets.step()\n",
    "        optimizer_c.step()\n",
    "\n",
    "        # ---- clamp c ----\n",
    "        with torch.no_grad():\n",
    "            lower = c_min_physical * 1.138\n",
    "            upper = c_max_physical\n",
    "            if idx > 0:\n",
    "                upper = torch.min(upper, previous_c * 0.98)\n",
    "            c.data.clamp_(lower, upper)\n",
    "\n",
    "        # ---- update history ----\n",
    "        c_history.append(c.item())\n",
    "\n",
    "        # ---- UPDATE BEST SOLUTION ----\n",
    "        if loss.item() < best_loss:\n",
    "            best_loss = loss.item()\n",
    "            best_c = c.item()\n",
    "\n",
    "        # ---- STOPPING: LOSS THRESHOLD ----\n",
    "        if loss.item() < 1e-6:\n",
    "            print(f\"✓ Loss reached threshold at epoch {epoch}\")\n",
    "            break\n",
    "\n",
    "\n",
    "        prev_c = c.item()\n",
    "\n",
    "        # ---- print debug ----\n",
    "        if epoch % 100 == 0:\n",
    "            print(\n",
    "                f\"Epoch {epoch:4d} | \"\n",
    "                f\"Loss={loss.item():.3e} | \"\n",
    "                f\"Phys={physics_penalty.item():.1e} | \"\n",
    "                f\"PDE={logs['pde']:.2e} | \"\n",
    "                f\"BC={logs['bc_top']:.2e} | \"\n",
    "                f\"INT={logs['interface']:.2e} | \"\n",
    "                f\"FAR={logs['far']:.2e} | \"\n",
    "                f\"AMP={logs.get('amp',0):.2e} | \"\n",
    "                f\"c={c.item():.6f}\"\n",
    "            )\n",
    "\n",
    "    dispersion.append([k.item(), best_c])\n",
    "    all_histories[k.item()] = {\n",
    "        \"total\": loss_total_history,\n",
    "        \"pde\": loss_pde_history,\n",
    "        \"bc\": loss_bc_history,\n",
    "        \"interface\": loss_int_history,\n",
    "        \"c_history\": c_history\n",
    "    }\n",
    "    print(f\"✓ Final c(k={k.item():.3f}) = {best_c:.6f}\")\n",
    "\n",
    "# --------------------------------------------------\n",
    "# Save dispersion curve\n",
    "# --------------------------------------------------\n",
    "torch.save(dispersion, \"final_dispersion.pt\")\n",
    "torch.save(all_histories, \"all_histories.pt\")\n",
    "print(\"\\nSaved: final_dispersion.pt\")\n",
    "print(\"Saved: all_histories.pt\")"
   ]
  },
