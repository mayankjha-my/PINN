    "L2 Error Analysis:\n",
    "━━━━━━━━━━━━━━━━━━\n",
    "L2 Error: {l2_error:.6f}\n",
    "Relative L2 Error: {l2_relative_error:.3f}%\n",
    "\n",
    "Error Statistics:\n",
    "━━━━━━━━━━━━━━━━━━\n",
