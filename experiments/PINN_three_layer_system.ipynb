    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# --------------------------------------------------\n",
    "# Load histories\n",
    "# --------------------------------------------------\n",
    "histories = torch.load(\"all_histories.pt\")\n",
    "\n",
    "# Sort k values\n",
    "k_list = sorted(histories.keys())\n",
    "\n",
    "# --------------------------------------------------\n",
    "# Fibonacci epochs\n",
    "# --------------------------------------------------\n",
    "fib_epochs = [1, 2]\n",
    "\n",
    "while fib_epochs[-1] < 10000:\n",
    "    fib_epochs.append(fib_epochs[-1] + fib_epochs[-2])\n",
    "\n",
    "fib_epochs = [f for f in fib_epochs if f <= 10000]\n",
    "\n",
    "print(\"Fibonacci epochs:\")\n",
    "print(fib_epochs)\n",
    "\n",
    "# --------------------------------------------------\n",
    "# Plot 1: All k values\n",
    "# --------------------------------------------------\n",
    "plt.figure(figsize=(11,7))\n",
    "\n",
    "final_losses = []\n",
    "\n",
    "for k in k_list:\n",
    "\n",
    "    loss = np.array(histories[k][\"total\"])\n",
    "\n",
    "    running_best = np.minimum.accumulate(loss)\n",
    "\n",
    "    final_losses.append(running_best[-1])\n",
    "\n",
    "    idx = np.array(fib_epochs) - 1\n",
    "    idx = idx[idx < len(running_best)]\n",
    "\n",
    "    sampled_loss = running_best[idx]\n",
