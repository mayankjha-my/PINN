   "source": [
    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# Load histories\n",
    "histories = torch.load(\"all_histories.pt\")\n",
    "\n",
    "# Sort all k values\n",
    "k_list = sorted(histories.keys())\n",
    "\n",
    "# Select 5 representative k values\n",
    "indices = np.linspace(0, len(k_list)-1, 5, dtype=int)\n",
    "selected_k = [k_list[i] for i in indices]\n",
    "\n",
    "print(\"Selected k values:\")\n",
    "for k in selected_k:\n",
    "    print(f\"{k:.6f}\")\n",
    "\n",
    "plt.figure(figsize=(9,6))\n",
    "\n",
    "markers = ['o', 's', '^', 'D', 'v']\n",
    "\n",
    "for i, k in enumerate(selected_k):\n",
    "\n",
    "    loss = np.array(histories[k][\"total\"])\n",
    "\n",
    "    # Running minimum loss\n",
    "    running_best = np.minimum.accumulate(loss)\n",
    "\n",
    "    loss = np.array(histories[k][\"total\"])\n",
    "    best_epoch = np.argmin(loss)\n",
    "\n",
    "    print(k, best_epoch, np.min(loss))\n",
    "\n",
    "    plt.semilogy(\n",
    "        running_best,\n",
    "        linewidth=2.5,\n",
    "        marker=markers[i],\n",
    "        markevery=max(len(running_best)//10, 1),\n",
    "        markersize=5,\n",
    "        label=fr\"$k={k:.3f}$\"\n",
    "    )\n",
    "\n",
    "plt.xlabel(\"Epoch\", fontsize=12)\n",
    "plt.ylabel(\"Running minimum loss\", fontsize=12)\n",
    "\n",
    "plt.grid(True, which='major', linestyle='--', alpha=0.5)\n",
    "plt.grid(True, which='minor', linestyle=':', alpha=0.3)\n",
    "\n",
    "plt.legend(\n",
    "    fontsize=10,\n",
    "    frameon=True,\n",
    "    fancybox=True,\n",
    "    loc='upper right'\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
